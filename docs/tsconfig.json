{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vitepress/client"],
    "paths": {
      "@hareui/vue": ["../packages/vue/src/index.ts"],
      "@hareui/vue/charts": ["../packages/vue/src/charts.ts"],
      "@/*": ["../packages/vue/src/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true
  },
  "include": ["demos"]
}
