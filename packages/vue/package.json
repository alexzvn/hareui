{
  "name": "@hareui/vue",
  "version": "0.3.0",
  "description": "HareUI — Vue 3 port of HeroUI v3",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "heroui",
    "hareui",
    "tailwindcss",
    "components",
    "ui"
  ],
  "homepage": "https://hareui.alexzvn.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexzvn/hareui.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/alexzvn/hareui/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/styles/index.css",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/styles/index.css",
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./carousel": {
      "types": "./dist/carousel.d.ts",
      "import": "./dist/carousel.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -R src/styles dist/styles",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "rm -rf dist && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@number-flow/vue": "^0.5.2",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.47",
    "defu": "^6.1.7",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "unplugin-vue-components": "^32.1.0"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.4",
    "d3-scale": "^4.0.0",
    "d3-shape": "^3.0.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-height": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-class-names": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.0",
    "vite": ">=6.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "d3-scale": {
      "optional": true
    },
    "d3-shape": {
      "optional": true
    },
    "embla-carousel": {
      "optional": true
    },
    "embla-carousel-auto-height": {
      "optional": true
    },
    "embla-carousel-auto-scroll": {
      "optional": true
    },
    "embla-carousel-autoplay": {
      "optional": true
    },
    "embla-carousel-class-names": {
      "optional": true
    },
    "embla-carousel-fade": {
      "optional": true
    },
    "embla-carousel-vue": {
      "optional": true
    },
    "embla-carousel-wheel-gestures": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@sinclair/typebox": "^0.34",
    "@sinclair/typemap": "^0.10.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-height": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-class-names": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "happy-dom": "^20.14.5",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.9",
    "typescript": "~6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "zod": "^4.6.5"
  }
}
