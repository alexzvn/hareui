{
  "name": "@hareui/vue",
  "version": "0.1.1",
  "description": "HareUI — Vue 3 port of HeroUI v3",
  "license": "MIT",
  "keywords": ["vue", "vue3", "heroui", "hareui", "tailwindcss", "components", "ui"],
  "homepage": "https://hareui.alexzvn.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexzvn/hareui.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/alexzvn/hareui/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/styles/index.css",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/styles/index.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && cp -R src/styles dist/styles",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "rm -rf dist && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "reka-ui": "^2.10.5",
    "tailwind-variants": "^3.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.4",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
